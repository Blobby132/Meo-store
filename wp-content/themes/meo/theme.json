{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1400px"
		},
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base",       "color": "#EEE8DC", "name": "Paper" },
				{ "slug": "surface",    "color": "#F8F4EA", "name": "Surface" },
				{ "slug": "surface-2",  "color": "#E4DCC9", "name": "Surface recessed" },
				{ "slug": "contrast",   "color": "#16231C", "name": "Ink" },
				{ "slug": "ink-muted",  "color": "#46523F", "name": "Ink muted" },
				{ "slug": "accent",     "color": "#B4842A", "name": "Gold" },
				{ "slug": "accent-ink", "color": "#7A5714", "name": "Gold (text safe)" },
				{ "slug": "secondary",  "color": "#4E617A", "name": "Slate blue" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Fraunces",
					"fontFamily": "\"Fraunces\", \"Iowan Old Style\", Georgia, serif"
				},
				{
					"slug": "body",
					"name": "IBM Plex Sans",
					"fontFamily": "\"IBM Plex Sans\", system-ui, -apple-system, \"Segoe UI\", sans-serif"
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, \"SF Mono\", Menlo, monospace"
				}
			],
			"fontSizes": [
				{ "slug": "small",   "name": "Small",   "size": "0.84rem", "fluid": { "min": "0.79rem", "max": "0.84rem" } },
				{ "slug": "medium",  "name": "Medium",  "size": "1.02rem", "fluid": { "min": "0.94rem", "max": "1.02rem" } },
				{ "slug": "large",   "name": "Large",   "size": "1.71rem", "fluid": { "min": "1.35rem", "max": "1.71rem" } },
				{ "slug": "x-large", "name": "X Large", "size": "2.88rem", "fluid": { "min": "1.94rem", "max": "2.88rem" } }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{ "slug": "20", "name": "1", "size": "0.5rem" },
				{ "slug": "30", "name": "2", "size": "1rem" },
				{ "slug": "40", "name": "3", "size": "1.5rem" },
				{ "slug": "50", "name": "4", "size": "2.25rem" },
				{ "slug": "60", "name": "5", "size": "3.5rem" },
				{ "slug": "70", "name": "6", "size": "5rem" }
			]
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "600", "lineHeight": "1.15" }
			},
			"link": { "color": { "text": "var(--wp--preset--color--secondary)" } }
		}
	}
}
