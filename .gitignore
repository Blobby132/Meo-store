/wp-content/plugins/
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/languages/
wp-config.php
wp-config-local.php

# --- Node / build ----------------------------------------------------------
node_modules/
npm-debug.log*
.npm/

# --- Local env -------------------------------------------------------------
.env
.env.local
*.local.json
.wp-env.override.json

# --- Database dumps & backups ---------------------------------------------
*.sql
*.sql.gz
/backups/

